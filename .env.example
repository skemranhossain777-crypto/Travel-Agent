# Copy this file to `.env` and fill in your real credentials.
# `.env` is git-ignored — never commit real keys.

# Gemini API mode: 0 = Gemini Developer API (AI Studio key), 1 = Vertex AI (enterprise)
GOOGLE_GENAI_USE_ENTERPRISE=0

# Your Gemini API key from https://aistudio.google.com/app/apikey
# NOTE: Different keys have separate rate-limit/quota buckets. If you hit
# "429 RESOURCE_EXHAUSTED", try a different key or a different model.
GOOGLE_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Optional: swap in a second Gemini key to load-balance quota (see README).
# GOOGLE_API_KEY_ALT=PASTE_A_SECOND_KEY_HERE
