# Copy this file to `.env.local` and fill in your real credentials.
# `.env.local` is git-ignored — never commit real keys.
#
# The web app uses the same Gemini API key as the Python agent at the repo root.
# Copy it from the root `.env` or from https://aistudio.google.com/app/apikey.

# Gemini API key used by the @google/adk agent in the /api/chat route handler.
# Falls back to GEMINI_API_KEY if unset.
GOOGLE_API_KEY=PASTE_YOUR_GEMINI_API_KEY_HERE

# Optional: point the skill loader at the travel skill directory.
# Defaults to ./skills/travel-agent-skill inside the web app (a copy of the
# root skills/travel-agent-skill, so the deployed app is self-contained).
# TRAVEL_SKILL_DIR=

# Optional: model overrides (defaults are gemini-2.5-flash for both).
# Rate limits are per model; if you hit 429 RESOURCE_EXHAUSTED, switch to a
# model in a separate quota bucket (see the root README).
# TRAVEL_AGENT_MODEL=gemini-2.5-flash
# TRAVEL_SEARCH_MODEL=gemini-2.5-flash
